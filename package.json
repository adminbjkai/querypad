{
  "name": "querypad",
  "version": "0.17.0",
  "private": true,
  "description": "Local-first data workspace: drop data files, see how they connect, and query them with SQL or plain English — DuckDB in the browser, plus a CLI.",
  "author": "QueryPad Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adminbjkai/querypad.git"
  },
  "homepage": "https://github.com/adminbjkai/querypad",
  "bin": {
    "querypad": "src/cli/index.ts"
  },
  "keywords": [
    "cursor-for-data",
    "duckdb",
    "sql",
    "ai",
    "llm",
    "data-understanding",
    "relationship-discovery",
    "semantic-model",
    "schema-inference",
    "data-analysis",
    "csv",
    "parquet",
    "cli",
    "claude",
    "local-first"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "querypad": "tsx src/cli/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "check:bundle": "node scripts/check-browser-bundle.mjs",
    "check": "npm run check:version && node scripts/run-parallel.mjs lint typecheck && npm run build && npm run check:bundle",
    "version": "npm run check:version",
    "collab": "node collab/server.mjs",
    "postinstall": "node scripts/copy-duckdb-wasm.mjs && node scripts/copy-editor-assets.mjs && node scripts/precompress-assets.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:cli": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@duckdb/duckdb-wasm": "^1.33.1-dev20.0",
    "@duckdb/node-api": "^1.5.3-r.3",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@xyflow/react": "^12.10.1",
    "apache-arrow": "^17.0.0",
    "idb-keyval": "^6.2.2",
    "lib0": "^0.2.119",
    "monaco-editor": "0.55.1",
    "next": "16.2.0",
    "pako": "^2.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "sql-formatter": "^15.9.0",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
